# ============================================================
# VMS Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with real credentials
# ============================================================

# --- Database (PostgreSQL) ---
# JDBC connection URL
DB_URL=jdbc:postgresql://localhost:5432/vms_db

# PostgreSQL username
DB_USERNAME=vms_user

# PostgreSQL password
DB_PASSWORD=vms_password

# --- Spring Profile ---
# Options: dev | prod | test
SPRING_PROFILES_ACTIVE=dev

